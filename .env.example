# Razorpay Test Mode — get from dashboard.razorpay.com → Settings → API Keys
RAZORPAY_KEY_ID=rzp_test_REPLACE_ME
RAZORPAY_KEY_SECRET=REPLACE_ME
RAZORPAY_WEBHOOK_SECRET=REPLACE_ME

# Ngrok — for local webhook testing
NGROK_PUBLIC_URL=https://REPLACE_ME.ngrok.io

# Ollama — local LLM (no key needed)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# Database — SQLite by default; swap to postgres://... for PostgreSQL
DATABASE_URL=sqlite:///./recoverx.db

# Guardrails (defaults baked in; override here to tune)
MAX_RETRIES_PER_TRANSACTION=4
MAX_CONTACTS_PER_24H=3
MAX_AUTO_APPROVED_AMOUNT=50000
STOP_RETRY_PROBABILITY_THRESHOLD=0.15
